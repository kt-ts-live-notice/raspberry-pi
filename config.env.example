# Copy this file to config.env and replace placeholders.
# Never commit config.env because DEVICE_TOKEN is a secret.

SERVER_URL=http://<IP-address>:8787/api/v1/audio-chunks
DEVICE_ID=yeongdeungpo-01
DEVICE_TOKEN=<device-token>

# Check your actual capture device with: arecord -l && arecord -L
# ReSpeaker Lite example when ALSA exposes card name "Lite":
AUDIO_DEVICE=plughw:CARD=Lite,DEV=0

BASE_DIR=/home/pi/subway-audio
